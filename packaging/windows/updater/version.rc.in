#include <winver.h>
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CEDAR_WINDOWS_BUILD_REVISION@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CEDAR_WINDOWS_BUILD_REVISION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CedarLogic contributors\0"
      VALUE "FileDescription", "CedarLogic digital logic simulator\0"
      VALUE "FileVersion", "@CEDAR_WINDOWS_BUILD_VERSION@\0"
      VALUE "InternalName", "CedarLogic\0"
      VALUE "LegalCopyright", "Cedarville University and CedarLogic contributors\0"
      VALUE "OriginalFilename", "CedarLogic.exe\0"
      VALUE "ProductName", "CedarLogic\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
